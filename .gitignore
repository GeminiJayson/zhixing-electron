# ---- 依赖与构建产物 ----
node_modules/
out/
dist/
build/
*.tsbuildinfo

# ---- 本地检查与截图产物 ----
.screenshots/
.screenshots/profile*/

# ---- 运行时数据（与 Python 版共用同一个 SQLite 文件，绝不入库）----
*.db
*.db-wal
*.db-shm
backups/

# ---- 凭据 ----
*.token
*.key
credentials*.txt

# ---- IDE / 系统 ----
.DS_Store
.idea/
.vscode/

# ---- Agent workspace 配置与个人内容（不入远端）----
AGENTS.md
AGENTS.md.backup.*
memory/

.commitmsg
.commitmsg*

# ---- 一次性脚本（用完即弃，不入库）----
scripts/tmp-*.mjs

dist-portable/

# 构建产物：dist/ 与任何 dist-<变体>/。用通配是因为 git add -A 曾把
# dist-nsis/ 下 180MB 的 exe 一起提交，被 GitHub 拒收（单文件上限 100MB）。
dist-*/


.build-tmp/

# G6 官方文档的本地镜像（.g6-docs/fetch.mjs 拉取，约 209 页 Markdown）。
# 第三方文档，仅供本地查阅与后续需求对照，不入库。
.g6-docs/
