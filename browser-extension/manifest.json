{
  "manifest_version": 3,
  "name": "知行 ZhiXing 密码助手",
  "version": "1.1.0",
  "description": "把网页上的登录凭据与正文剪藏交给本机的知行应用。不联网、不上传。",
  "permissions": [
    "storage",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "vendor/Readability.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "知行 ZhiXing",
    "default_popup": "popup.html"
  }
}
