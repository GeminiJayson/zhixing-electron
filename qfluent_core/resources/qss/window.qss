/* =============================================================================
   qfluent_core / window.qss —— 窗口壳体皮肤（自绘标题栏 + 侧边导航 + 内容区）
   作用域全部挂在 #FluentTemplateWindow 之下，避免污染宿主项目的其它控件。
   ============================================================================= */

/* 无边框窗口圆角：root 透明，四角由标题栏（上）与导航/内容区（下）拼出 */
#FluentTemplateWindow { background: transparent; }

/* --- 标题栏 --- */
#FCTitleBar { background: $layer; border-bottom: $border-w solid $border;
  border-top-left-radius: $radius-lg; border-top-right-radius: $radius-lg; }
#FCTitleLabel { color: $fg; font-weight: 600; padding: 0 6px; background: transparent; }
#FCSignatureLabel { color: $fg2; padding: 0 8px; background: transparent; }

#FCCommandCapsule { background: $layer; color: $fg2; border: $border-w solid $border2;
  border-radius: $capsule-radius; padding: 0 14px; text-align: center; }
#FCCommandCapsule:hover { border-color: $accent; color: $fg; }
#FCCommandCapsule:pressed { background: $control-hover; }

/* --- 窗口按钮（最小/最大/关闭）：命中区不可小于 32px（无障碍） --- */
#FCWinButton, #FCWinButtonClose { background: transparent; border: none;
  border-radius: $radius-ctl; color: $fg2; padding: 0;
  min-width: $control-h-icon; max-width: $control-h-icon;
  min-height: $control-h-sm; max-height: $control-h-sm; }
#FCWinButton:hover, #FCWinButtonClose:hover { background: $control-hover; color: $fg; }
#FCWinButton:pressed, #FCWinButtonClose:pressed { background: $control-pressed; }
#FCWinButtonClose:hover { background: $danger; color: $accent-on; }

/* --- 侧边导航 --- */
#FCNavPanel { background: $layer; border-right: $border-w solid $border;
  border-bottom-left-radius: $radius-lg; }
#FCNavIndicator { background: $accent; border-radius: $radius-xs; }
#FCNavButton { background: transparent; border: none; border-radius: $radius-ctl;
  color: $fg2; padding: 0 10px; text-align: left; font-size: $control-font-size;
  min-height: $control-content-h; max-height: $control-content-h; }
/* 折叠态：文字转图标块（居中单字/符号，尺寸收成方形） */
#FCNavButton[collapsed="true"] { padding: 0; text-align: center;
  min-height: $control-h; max-height: $control-h; }
#FCNavButton:hover { background: $control-hover; color: $fg; }
#FCNavButton:checked { background: $accent-soft; color: $accent; font-weight: 600; }
#FCNavButton:focus { border: $focus-ring solid $accent; }
/* 吸附在侧边栏右边界上的小圆钮：正方形、无内边距（否则会被 QToolButton 的
   padding 撑宽成椭圆） */
#FCNavToggle { background: $layer; border: $border-w solid $border; color: $fg2;
  padding: 0; border-radius: $radius-pill;
  min-width: $control-h-sm; max-width: $control-h-sm;
  min-height: $control-h-sm; max-height: $control-h-sm; }
#FCNavToggle:hover { background: $control-hover; color: $fg;
  border-color: $border-strong; }
#FCNavToggle:focus { border: $focus-ring solid $accent; }

/* --- 内容区 --- */
#FCContent { background: $canvas; border-bottom-right-radius: $radius-lg; }
#FCContentStack { background: transparent; }
